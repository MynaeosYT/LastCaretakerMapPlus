{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last Caretaker Secrets Dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "game",
    "secretRecordCount",
    "secrets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "game": {
      "type": "string",
      "const": "The Last Caretaker"
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "locationName",
          "longitude",
          "latitude",
          "coordinatePrecision",
          "secretType",
          "status",
          "confidence",
          "playerVerified",
          "spoilerLevel",
          "hint",
          "solution",
          "accessConditions",
          "contentsSummary",
          "knownIssues",
          "tags",
          "notes",
          "sourceUrls"
        ]
      }
    }
  }
}
