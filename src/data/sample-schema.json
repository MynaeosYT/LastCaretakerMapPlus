{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/the-last-caretaker/sample-schema.json",
  "title": "The Last Caretaker sample dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "game",
    "generatedAt",
    "sampleCount",
    "categoryCounts",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "game": {
      "type": "string",
      "const": "The Last Caretaker"
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "datasetStatus": {
      "type": "string"
    },
    "sampleCount": {
      "type": "integer",
      "const": 104
    },
    "categoryCounts": {
      "type": "object",
      "required": [
        "holo_memory",
        "cave_painting",
        "rock_painting"
      ],
      "properties": {
        "holo_memory": {
          "type": "integer",
          "const": 60
        },
        "cave_painting": {
          "type": "integer",
          "const": 15
        },
        "rock_painting": {
          "type": "integer",
          "const": 29
        }
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 104,
      "maxItems": 104,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sampleId",
          "name",
          "category",
          "locationName",
          "longitude",
          "latitude",
          "coordinatePrecision",
          "status",
          "positionNote",
          "underwater",
          "depthMeters",
          "aliases",
          "sourceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sample-[0-9]{3}$"
          },
          "sampleId": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "holo_memory",
              "cave_painting",
              "rock_painting"
            ]
          },
          "locationName": {
            "type": "string",
            "minLength": 1
          },
          "relatedLocations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "longitude": {
            "type": "number"
          },
          "latitude": {
            "type": "number"
          },
          "coordinatePrecision": {
            "type": "string",
            "enum": [
              "exact",
              "poi",
              "approximate"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "community-confirmed",
              "unverified"
            ]
          },
          "positionNote": {
            "type": "string"
          },
          "underwater": {
            "type": "boolean"
          },
          "depthMeters": {
            "type": [
              "number",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
